# 免费 API-Football 密钥。复制本文件为 .env 后填写；.env 已被 Git 忽略。
API_FOOTBALL_KEY=

# 留空会自动使用当前赛季起始年份。需要尝试补旧赛季时才填写，例如 2024,2025。
API_FOOTBALL_SEASONS=

# 每轮最多使用 20 次请求；GitHub Actions 每 6 小时运行一次，理论上不超过免费版每日 100 次。
API_FOOTBALL_MAX_REQUESTS=20

# 每轮最多补充 15 场赛后详情，并始终为当天保留至少 10 次请求。
API_FOOTBALL_MAX_DETAILS=15
API_FOOTBALL_RESERVE_REQUESTS=10

# 免费版每分钟最多 10 次，因此请求之间至少间隔 6.5 秒。
API_FOOTBALL_INTERVAL_MS=6500
